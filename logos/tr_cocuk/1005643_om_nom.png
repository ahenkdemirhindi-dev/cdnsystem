c/chunks/2861-c88ed3960269b22c.js\",\"2584\",\"static/chunks/2584-2bdbb8d50375fb6b.js\",\"421\",\"static/chunks/app/(app)/franchise/cut-the-rope/page-da37c997447f34bf.js\"],\"FranchisePressKit\"]\n1e:[\"$\",\"$L27\",\"ComponentSectionsFranchiseTextBlock#21\",{\"section\":{\"__typename\":\"ComponentSectionsFranchiseTextBlock\",\"id\":\"21\",\"blockTitle\":null,\"text\":\"Cut the Rope is a puzzle game franchise built around a simple idea: cut the ropes, figure out the sequence, and get the candy to Om Nom.\\n\\nAcross the series, that core mechanic evolves with new interactions, characters, and level designs while keeping the gameplay quick, responsive, and easy to pick up.\",\"width\":\"w50\"}}]\n"])</script><script>self.__next_f.push([1,"20:[\"$\",\"$L28\",\"ComponentSectionsFranchiseFeatures#11\",{\"section\":{\"__typename\":\"ComponentSectionsFranchiseFeatures\",\"id\":\"11\",\"title\":\"How to play\",\"features\":[{\"__typename\":\"ComponentSharedFranchiseFeature\",\"id\":\"31\",\"text\":\"Cut ropes to guide the candy to Om Nom. Watch how it swings, falls, and reacts, then choose the right moment to act.\",\"icon\":{\"__typename\":\"UploadFile\",\"data\":{\"__typename\":\"UploadFile\",\"id\":\"91\",\"attributes\":{\"__typename\":\"UploadFile\",\"url\":\"/uploads/features_ca1f383a1e.svg\",\"width\":40,\"height\":40,\"caption\":null,\"alternativeText\":null}}}},{\"__typename\":\"ComponentSharedFranchiseFeature\",\"id\":\"32\",\"text\":\"Use objects in each level — bubbles, air cushions, spikes, and more — to shape the path. The order and timing of your moves matter, especially as puzzles become more complex.\",\"icon\":{\"__typename\":\"UploadFile\",\"data\":{\"__typename\":\"UploadFile\",\"id\":\"87\",\"attributes\":{\"__typename\":\"UploadFile\",\"url\":\"/uploads/features_1_fdcff4aa22.svg\",\"width\":40,\"height\":40,\"caption\":null,\"alternativeText\":null}}}},{\"__typename\":\"ComponentSharedFranchiseFeature\",\"id\":\"33\",\"text\":\"Collect stars when you can and aim to solve each level efficiently. New mechanics build on the same core idea, so each step forward adds a new twist.\",\"icon\":{\"__typename\":\"UploadFile\",\"data\":{\"__typename\":\"UploadFile\",\"id\":\"330\",\"attributes\":{\"__typename\":\"UploadFile\",\"url\":\"/uploads/feature_star_e50baead92.svg\",\"width\":40,\"height\":40,\"caption\":null,\"alternativeText\":null}}}}]}}]\n"])</script><script>self.__next_f.push([1,"21:[\"$\",\"$L29\",\"ComponentSectionsOmNomGamesPage#19\",{\"section\":{\"__typename\":\"ComponentSectionsOmNomGamesPage\",\"id\":\"19\",\"title\":\"Cut the rope\",\"link\":null}}]\n22:[\"$\",\"$L27\",\"ComponentSectionsFranchiseTextBlock#22\",{\"section\":{\"__typename\":\"ComponentSectionsFranchiseTextBlock\",\"id\":\"22\",\"blockTitle\":null,\"text\":\"Om Nom sits at the center of the Cut the Rope franchise. \\nNo matter what, he is always hungry and needs your help!\",\"width\":\"w50\"}}]\n"])</script><script>self.__next_f.push([1,"24:[\"$\",\"$L2a\",\"ComponentSectionsGameSocial#73\",{\"section\":{\"__typename\":\"ComponentSectionsGameSocial\",\"id\":\"73\",\"title\":\"Franchise social media\",\"links\":[{\"__typename\":\"ComponentSharedSocialLink\",\"id\":\"294\",\"title\":\"Facebook\",\"url\":\"https://www.facebook.com/cuttherope\",\"icon\":{\"__typename\":\"UploadFile\",\"data\":{\"__typename\":\"UploadFile\",\"id\":\"324\",\"attributes\":{\"__typename\":\"UploadFile\",\"url\":\"/uploads/Facebook_40faf923c5.svg\",\"width\":32,\"height\":32,\"caption\":null,\"alternativeText\":null}}}},{\"__typename\":\"ComponentSharedSocialLink\",\"id\":\"295\",\"title\":\"Instagram\",\"url\":\"https://www.instagram.com/omnomstories/\",\"icon\":{\"__typename\":\"UploadFile\",\"data\":{\"__typename\":\"UploadFile\",\"id\":\"325\",\"attributes\":{\"__typename\":\"UploadFile\",\"url\":\"/uploads/Instagram_b83318e564.svg\",\"width\":32,\"height\":32,\"caption\":null,\"alternativeText\":null}}}},{\"__typename\":\"ComponentSharedSocialLink\",\"id\":\